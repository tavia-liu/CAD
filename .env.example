# Copy to .env (gitignored) and fill in. Central secrets/config for all benchmark jobs.
# Auto-loaded by agentdojo (load_dotenv(".env")) and sourced by the dojo_*/gcg run scripts.

# OpenRouter — single key for ALL API target-model jobs (=> direct per-key cost tracking).
OPENROUTER_API_KEY=

# Hugging Face — model/dataset downloads (Jina v3 embedder, gated filter-defense models).
HUGGING_FACE_HUB_TOKEN=

# Local vLLM OpenAI-compatible server port (target model 'vllm_parsed').
LOCAL_LLM_PORT=8000
